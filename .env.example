FLICKR_ARCHIVE_PATH=./archive

# Display name in the nav brand and browser title (default: My Archive)
SITE_NAME=My Archive

# Optional JSON array of nav links. Omit to keep the defaults (Photostream, Albums, About).
# Each item: { "href", "label", "icon"? }. Icons: grid, albums, user, search, upload, blog, external
# Internal paths start with /. http(s) URLs are allowed.
# Import is never driven by this list — it appears only when web import is authorized.
# Example:
# NAV_LINKS=[{"href":"/","label":"Photos","icon":"grid"},{"href":"/albums","label":"Albums","icon":"albums"},{"href":"https://example.com","label":"Blog","icon":"blog"}]
NAV_LINKS=

# local | blob — leave unset for local disk. Use blob on Vercel after npm run upload:blob.
ARCHIVE_STORAGE=local

# Public base URL printed by `npm run upload:blob`, e.g.
# https://xxxxx.public.blob.vercel-storage.com/flickr-archive
BLOB_PUBLIC_BASE_URL=

# Pathname prefix inside the Blob store (default: flickr-archive)
BLOB_ARCHIVE_PREFIX=flickr-archive

# From the Vercel Blob store (needed for upload:blob; optional at runtime for public media)
BLOB_READ_WRITE_TOKEN=

# Production is opt-in: web import is off unless this is true.
# Local/dev defaults to enabled when unset. Always disabled on Vercel (no persistent disk).
IMPORT_ENABLED=false

# Required in production when IMPORT_ENABLED=true (non-Vercel hosts).
IMPORT_SECRET=

# Set true only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
TRUST_PROXY=false
